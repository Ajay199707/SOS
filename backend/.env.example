# Copy to .env and fill in real values. Never commit .env with secrets.
PORT=4000
DATABASE_URL=postgres://sos:sos_dev@localhost:5432/sos_guardian
JWT_ACCESS_SECRET=change-me-access-min-32-chars
JWT_REFRESH_SECRET=change-me-refresh-min-32-chars
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d

# FCM - path to service account JSON or empty to run in stub mode
FCM_SERVICE_ACCOUNT_PATH=
FCM_STUB=true

# SMS fallback provider: stub | twilio
SMS_PROVIDER=stub
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# WebRTC TURN (coturn) - leave empty for dev (STUN only)
TURN_URLS=
TURN_USERNAME=
TURN_CREDENTIAL=
TURN_SHARED_SECRET=
TURN_CREDENTIAL_TTL_SEC=86400

# Frontend / receiver origins
CORS_ORIGIN=http://localhost:5173

# Data retention (days) for location points
LOCATION_RETENTION_DAYS=30
